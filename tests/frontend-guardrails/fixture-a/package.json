{
  "name": "fixture-a-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:probe": "tsc --noEmit -p tsconfig.probes.json",
    "deps": "depcruise --output-type err-long src",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run deps",
    "knip": "knip",
    "dup": "jscpd . --reporters console,silent",
    "dup:markup": "jscpd . --format markdown,html,css --threshold 15 --reporters console,silent",
    "mutation": "stryker run",
    "doctor": "react-doctor",
    "check:report": "pnpm run knip --no-exit-code && pnpm run dup --no-exit-code && pnpm run doctor",
    "openapi-ts": "openapi-ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "jscpd": "^5.2.0",
    "jsdom": "^26.1.0",
    "knip": "^6.35.1",
    "react-doctor": "^0.9.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
